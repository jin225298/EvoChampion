# =============================================================================
# Generic Benchmark Configuration
# =============================================================================
# The benchmark dataset used for evaluation (e.g. "openai/gsm8k")
BENCHMARK_DATASET_ID=gsm8k
BENCHMARK_SUBSET=main
BENCHMARK_SPLIT=train
BENCHMARK_EVAL_SPLIT=test
# Field mappings: how to extract question/answer from dataset rows
BENCHMARK_QUESTION_KEY=question
BENCHMARK_ANSWER_KEY=answer
# Format: "gsm8k" (step markers <<...>>) | "alpaca" | "generic"
BENCHMARK_FORMAT=gsm8k
# Instruction prefix prepended to every inference prompt
INSTRUCTION_PREFIX=请解答下面的题目。\n
# Whether to stratify the global probe by module
GLOBAL_PROBE_STRATIFIED_BY_MODULE=true
# Offset for benchmark holdout split (defaults to GLOBAL_PROBE_HOLDOUT_OFFSET)
# BENCHMARK_HOLDOUT_OFFSET=0

# =============================================================================
# Model Configuration
# =============================================================================
BASE_MODEL_NAME=
# Path to the current best (champion) model checkpoint
CHAMPION_MODEL_PATH=
# Directory where candidate (newly trained) models are stored
CANDIDATE_MODEL_DIR=./artifacts/candidates
# Candidate retention. 0 keeps all candidates; positive values keep current champion
# plus N most recent rollback/prune candidates for the current trace_id.
# CANDIDATE_RETENTION_KEEP_RECENT_NON_PROMOTED=0

# LLM Agent Configuration (set USE_LLM_AGENTS=1 to enable LLM-based decisions)
USE_LLM_AGENTS=1
# Base model used by LLM agents (defaults to BASE_MODEL_NAME if not set)
AGENT_BASE_MODEL_NAME=
LLM_AGENT_MAX_NEW_TOKENS=384
# Max tokens for leaf-level agent calls (e.g. single classification, short reasoning)
# LLM_AGENT_LEAF_MAX_NEW_TOKENS=96

# -----------------------------------------------------------------------------
# Training Configuration
# -----------------------------------------------------------------------------
# Path to LLaMA-Factory training YAML template
TRAINING_CONFIG_TEMPLATE=./config/templates/llama_factory_sft.yaml
# Path to the LLaMA-Factory installation root
LLAMA_FACTORY_ROOT=
# Finetuning type: "full" | "lora"
TRAIN_FINETUNING_TYPE=full
# Timeout for a single training run (seconds)
TRAINING_TIMEOUT_SECONDS=3600

# -----------------------------------------------------------------------------
# Training Gates
# -----------------------------------------------------------------------------
# Minimum required new-skill accuracy gain to accept a candidate model
MIN_NEW_SKILL_GAIN=0.01

# -----------------------------------------------------------------------------
# LoRA Configuration (used when TRAIN_FINETUNING_TYPE=lora)
# -----------------------------------------------------------------------------
LORA_RANK=8
LORA_ALPHA=16
LORA_DROPOUT=0.05
LORA_TARGET_MODULES=q_proj,v_proj

# -----------------------------------------------------------------------------
# HuggingFace Cache
# -----------------------------------------------------------------------------
# HF_HOME=

# =============================================================================
# MCTS / DAG Exploration Configuration
# =============================================================================
# Exploration coefficient for MCTS node selection (higher = more exploration)
# MCTS_EXPLORATION_C_NODE=0.1
# Exploration coefficient for MCTS action selection
# MCTS_EXPLORATION_C_ACTION=0.15
# Number of cold-start edges for MCTS tuner
# MCTS_TUNER_COLD_START_EDGES=5
# MCTS mutation scale bounds for continuous action parameters
# MCTS_MUTATION_SCALE_MIN=0.5
# MCTS_MUTATION_SCALE_MAX=2.0
# Bonus reward when a candidate passes the evaluation gate
# REWARD_GATE_BONUS=0.05
# Bonus reward when evolution reaches the stop condition
# REWARD_STOP_BONUS=0.15
# Path to MCTS action space definition JSON
# MCTS_ACTION_SPACE_PATH=./config/mcts_action_space.json

# =============================================================================
# Search Configuration
# =============================================================================
# Max number of HuggingFace dataset repos to retrieve per search
SEARCH_DATASET_REPO_LIMIT=5
# Timeout for a single search request (seconds)
SEARCH_TIMEOUT_SECONDS=120
# Fallback mode when HF API is unreachable: "empty" | "predefined"
SEARCH_FALLBACK_MODE=empty
# Comma-separated fallback datasets (used when SEARCH_FALLBACK_MODE=predefined)
SEARCH_FALLBACK_DATASETS=gsm8k:main:train,microsoft/orca-math-word-problems-200k::train

# =============================================================================
# Dataset Cleaner Codegen Configuration
# =============================================================================
# Set DATA_CLEANER_PROVIDER=deepseek to generate deterministic dataset cleaners
# during first dataset admission.
DATA_CLEANER_PROVIDER=off
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CLEANER_MODEL=deepseek-v4-flash
DATA_CLEANER_MAX_REPAIR_ATTEMPTS=2
DATA_CLEANER_REQUEST_TIMEOUT_SECONDS=120

# =============================================================================
# Filter Configuration
# =============================================================================
# Target number of training questions per round
FILTER_TARGET_QUESTIONS_PER_ROUND=90
# Sampling method: "random" | "stratified" | "difficulty_balanced"
FILTER_SAMPLING_METHOD=stratified
# Deduplicate questions before training
FILTER_DEDUPLICATE=true
# Drop questions the model has already mastered
FILTER_DROP_MASTERED=true
# Ratio of samples to bias toward the target dynamic-difficulty bucket (0.0–1.0)
# TARGET_BUCKET_RATIO=0.7
# Max questions to screen from each dataset
# SCREENING_ENTRY_MAX_QUESTIONS=500
# Min remaining questions in window to avoid early exhaustion
# SCREENING_MIN_NEXT_WINDOW_REMAINDER=500

# =============================================================================
# Difficulty & Mastery Configuration
# =============================================================================
# Round number after which "late round" difficulty bias takes effect
# DIFFICULTY_LATE_ROUND=5
# Minimum easy questions in early rounds
# DIFFICULTY_EARLY_EASY_MIN=5
# Minimum medium questions in early rounds
# DIFFICULTY_EARLY_MEDIUM_MIN=2
# Minimum easy questions in late rounds
# DIFFICULTY_LATE_EASY_MIN=8
# Minimum medium questions in late rounds
# DIFFICULTY_LATE_MEDIUM_MIN=4
# Ratio of correct rollouts required to mark a question as mastered
# MASTERED_CORRECT_RATIO=0.75
# Absolute threshold: min correct rollouts to consider mastered (default: ROLLOUT_TIMES * MASTERED_CORRECT_RATIO)
# MASTERED_CORRECT_THRESHOLD=6

# =============================================================================
# Rollout Configuration (Send fan-out parallel execution)
# =============================================================================
# Number of parallel rollout workers per question
ROLLOUT_TIMES=4
# Max concurrent rollout tasks
ROLLOUT_MAX_CONCURRENT=4
# Sampling temperature for rollout inference
# ROLLOUT_TEMPERATURE=0.7
# Nucleus sampling top-p for rollout inference
# ROLLOUT_TOP_P=0.95

# =============================================================================
# Evaluation Gates
# =============================================================================
# Minimum accuracy on old (previously mastered) skills to avoid forgetting
EVAL_OLD_SKILL_GATE=0.95
# Minimum accuracy on newly trained skills to accept the candidate
EVAL_NEW_SKILL_GATE=0.60
# Minimum accuracy on the global probe set
EVAL_PROBE_ACC_GATE=0.75
# Max items per batch: test set evaluation
EVAL_TEST_MAX_ITEMS=120
# Max items per batch: co-test set evaluation
EVAL_COTEST_MAX_ITEMS=60
# Max items per batch: mastered set evaluation
EVAL_MASTERED_MAX_ITEMS=50

# -----------------------------------------------------------------------------
# Holdout Evaluation (separate held-out benchmark for unbiased measurement)
# -----------------------------------------------------------------------------
# Number of questions to use for holdout evaluation
# HOLDOUT_EVAL_SIZE=50
# Random seed for holdout split
# HOLDOUT_EVAL_SEED=42
# Tolerance for holdout accuracy deviation (triggers warning if exceeded)
# HOLDOUT_ERROR_TOLERANCE=0.05
# Tolerance for frozen probe accuracy degradation
# FROZEN_DEGRADE_TOLERANCE=0.03
# Weight of forgetting penalty in composite reward
# REWARD_FORGETTING_PENALTY_WEIGHT=0.20

# -----------------------------------------------------------------------------
# Early Termination
# -----------------------------------------------------------------------------
# Number of consecutive rollback rounds before early termination
# EARLY_TERMINATION_ROLLBACK_STREAK=4
# Number of rollout workers during test-time evaluation
# TEST_ROLLOUT_TIMES=3
# Tolerance for forgetting rate during test evaluation
# TEST_FORGETTING_TOLERANCE=0.10

# =============================================================================
# Probe Set Configuration
# =============================================================================
# Number of probe questions per class/category
PROBE_SET_SIZE_PER_CLASS=10
# Path to the seed probe bank JSON file
PROBE_BANK_PATH=./config/probe_bank_seed.json
# Source of the global probe: "benchmark_holdout" | "benchmark_eval"
GLOBAL_PROBE_SOURCE=benchmark_holdout
# Size of the global probe set
GLOBAL_PROBE_SIZE=500
# Size of the frozen (never-changing) probe set (defaults to GLOBAL_PROBE_SIZE)
FROZEN_PROBE_SIZE=500
# Frozen probe scorer: "local" uses the JSON/JSONL frozen set; "mathbench_opencompass"
# runs OpenCompass MathBench and stores that score as probe_acc_frozen.
FROZEN_PROBE_EVAL_METHOD=local
# Which split of the benchmark to use for the global probe (defaults to BENCHMARK_EVAL_SPLIT)
# GLOBAL_PROBE_SPLIT=test
# Offset into the benchmark for global probe holdout
# GLOBAL_PROBE_HOLDOUT_OFFSET=0
# Max items for probe evaluation per batch
# PROBE_EVAL_MAX_ITEMS=120
# Number of rollouts for probe difficulty estimation (defaults to ROLLOUT_TIMES)
# PROBE_DIFFICULTY_ROLLOUTS=4

# Fixed Benchmark (unchanging reference set)
FIXED_BENCHMARK_SOURCE=benchmark_eval
FIXED_BENCHMARK_SIZE=500
FIXED_BENCHMARK_SEED=20260511

# MathBench/OpenCompass probe configuration. Set FROZEN_PROBE_EVAL_METHOD=mathbench_opencompass
# to replace the local frozen probe accuracy with MathBench's OpenCompass summary score.
# MATHBENCH_OPENCOMPASS_ROOT=/path/to/opencompass
# MATHBENCH_OPENCOMPASS_PYTHON=/path/to/python
# MATHBENCH_DATASET=mathbench_gen
# MATHBENCH_SUMMARIZER=mathbench_v1_2024
# MATHBENCH_WORK_DIR=./artifacts/mathbench_probe
# MATHBENCH_MAX_SEQ_LEN=2048
# MATHBENCH_HF_BATCH_SIZE=8
# MATHBENCH_NUM_GPUS=1
# MATHBENCH_NO_BATCH_PADDING=0
# MATHBENCH_MODEL_KWARGS=device_map='auto'
# MATHBENCH_TOKENIZER_KWARGS=padding_side='left' truncation='left' use_fast=False
# MATHBENCH_EXTRA_ARGS=

# External Probe (optional external evaluation data; files are supplied by the user)
EXTERNAL_PROBE_PATH=./data/external_probe.jsonl
# Path to external probe manifest (maps probe IDs to metadata)
# EXTERNAL_PROBE_MANIFEST_PATH=./data/external_probe_manifest.json
# Max items for external probe evaluation
# EXTERNAL_PROBE_EVAL_MAX_ITEMS=300
# Whether to gate candidate promotion on external probe performance
USE_EXTERNAL_PROBE_GATE=true

# =============================================================================
# vLLM Configuration
# =============================================================================
# Whether to use vLLM for inference (0=transformers, 1=vLLM)
# USE_VLLM=0
# Whether to also use vLLM for local checkpoint inference (requires USE_VLLM=1)
# USE_VLLM_FOR_LOCAL_CHECKPOINTS=0
# Run local checkpoint vLLM inference in a short-lived child process so training
# CUDA allocations cannot poison post-training candidate evaluation.
USE_VLLM_LOCAL_CHECKPOINT_SUBPROCESS=1
# Timeout for the isolated local-checkpoint vLLM child process (seconds)
VLLM_LOCAL_CHECKPOINT_SUBPROCESS_TIMEOUT_SECONDS=3600
# GPU memory fraction for the vLLM engine (0.0–1.0)
VLLM_GPU_MEMORY_UTILIZATION=0.70
# Force eager execution (disable CUDA graph, more stable but slower; 0=off, 1=on)
VLLM_ENFORCE_EAGER=1
# Per-engine GPU memory fraction for multi-engine mode (0 means auto from VLLM_GPU_MEMORY_UTILIZATION)
VLLM_PER_ENGINE_GPU_MEMORY_UTILIZATION=0.65
# Max number of vLLM engines to keep in cache
VLLM_MAX_CACHED_ENGINES=1
# Maximum sequence length for vLLM model (tokens)
# VLLM_MAX_MODEL_LEN=2048
# Enable vLLM Automatic Prefix Caching (APC) inside Ray actors (0=off, 1=on)
VLLM_ENABLE_PREFIX_CACHING=1
# Ray cluster address for pure Ray vLLM actors: "local" starts a local Ray runtime, "auto" connects to an existing cluster
RAY_ADDRESS=local
# Ray namespace used for named, detached vLLM actors
RAY_NAMESPACE=evochampion
# GPU resources reserved by each Ray vLLM actor
VLLM_RAY_ACTOR_NUM_GPUS=1
# Ray actor restart policy for vLLM workers
VLLM_RAY_ACTOR_MAX_RESTARTS=1
VLLM_RAY_ACTOR_MAX_TASK_RETRIES=0
# Concurrent Ray actor method calls accepted before vLLM schedules them into its async engine
VLLM_RAY_ACTOR_MAX_CONCURRENCY=8
# Timeout for Ray vLLM actor to become ready (seconds)
# VLLM_WORKER_READY_TIMEOUT=300

# =============================================================================
# Replay Buffer Configuration
# =============================================================================
# Maximum number of questions stored in the replay buffer
REPLAY_BUFFER_MAX_SIZE=1000
# Fraction of training data to sample from the replay buffer
REPLAY_BUFFER_SAMPLE_RATIO=0.3
# Minimum number of questions to sample from replay buffer
# REPLAY_BUFFER_MIN_SAMPLE_SIZE=300

# =============================================================================
# Data Sharding & Buffer Pool Configuration
# =============================================================================
# Number of shards to split each dataset into (controls data diversity)
# DATASET_SHARD_COUNT=10
# Number of questions per shard
# DATASET_SHARD_SIZE=500
# Shard selection policy: "single" | "balanced"
# DATASET_SHARD_SELECTION_POLICY=single
# Maximum size of the test buffer (holds questions for future test evaluation)
# TEST_BUFFER_MAX_SIZE=500
# Fraction of new questions to sample into the test buffer
# TEST_BUFFER_SAMPLE_RATIO=0.20
# Overflow test buffer questions back into the training pool when full
# TEST_BUFFER_OVERFLOW_TO_TRAIN=true
# Maximum size of the probe candidate pool
# PROBE_POOL_MAX_SIZE=200
# Fraction of new questions to intake into the probe pool
# PROBE_POOL_INTAKE_RATIO=0.05
# Fraction of probe pool to sample for evaluation
# PROBE_POOL_EVAL_SAMPLE_RATIO=0.20
# Hard-ratio threshold for merging datasets (above this = candidate is "hard" dominated)
# DATA_HARD_RATIO_MERGE_THRESHOLD=0.80
# Minimum number of training questions required per round
# DATA_MIN_TRAIN_QUESTIONS_PER_ROUND=64
# Max retries for data window selection before falling back
# DATA_WINDOW_RETRY_LIMIT=2

# =============================================================================
# Classification Configuration
# =============================================================================
# Whether to use GLiNER for classification (1=yes, 0=keyword-fallback)
USE_GLINER=1
# GLiNER model name on HuggingFace
GLINER_MODEL_NAME=urchade/gliner_medium-v2.1
# Target classification labels (comma-separated; empty = auto-detect via prompt_designer)
CLASSIFIER_TARGET_LABELS=
# Minimum confidence threshold for classification
CLASSIFIER_MIN_CONFIDENCE=0.7

# =============================================================================
# LLM-as-Judge Configuration
# =============================================================================
# Whether to use an LLM for soft scoring of answers (0=exact-match only)
# USE_LLM_AS_JUDGE=0
# Max items to score via LLM judge per evaluation (0=unlimited)
# LLM_JUDGE_MAX_ITEMS=0

# =============================================================================
# Data Split Configuration
# =============================================================================
# Fraction of questions for training
TRAIN_SPLIT_RATIO=0.7
# Fraction of questions for co-test (held-out from training but used in evaluation)
COTEST_SPLIT_RATIO=0.0
# Fraction of questions for the fixed test set
TEST_SPLIT_RATIO=0.3
# Fraction of questions for the probe set
# PROBE_SPLIT_RATIO=0.05

# =============================================================================
# Evolution Loop
# =============================================================================
# Maximum number of evolution rounds
MAX_ROUNDS=3
# Trace ID for this evolution run (empty = auto-generated)
# EVOLVE_TRACE_ID=
# Maximum questions to load from a single dataset (falls back to DATA_WINDOW_SIZE → SCREENING_ENTRY_MAX_QUESTIONS)
# MAX_QUESTIONS_PER_DATASET=500

# =============================================================================
# Inference Configuration
# =============================================================================
# Maximum new tokens generated during inference
INFERENCE_MAX_NEW_TOKENS=256
# Batch size for inference
INFERENCE_BATCH_SIZE=8

# =============================================================================
# Harness Configuration
# =============================================================================
# Maximum retries for harness operations (contract validation, dry-run, etc.)
HARNESS_MAX_RETRIES=3
# Timeout for harness operations (seconds)
HARNESS_TIMEOUT_SECONDS=3600
# Whether to enforce harness contracts (pre/post conditions)
ENFORCE_HARNESS_CONTRACTS=true


# =============================================================================
# Logging Configuration
# =============================================================================
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
